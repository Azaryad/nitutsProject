<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://tlv-transfers.com/bpmn/6.1"
             id="def_6_1">

  <!-- ═══════════════════════════════════════════════════════════
       COLLABORATION
  ═══════════════════════════════════════════════════════════ -->
  <collaboration id="collab1" name="6.1 - Order Intake and Initial Assignment">
    <participant id="part_office" name="TLV Transfers - Office" processRef="proc_office"/>
    <participant id="part_rc"     name="Ride Control API"       processRef="proc_rc"/>
    <participant id="part_driver" name="Driver / Supplier"      processRef="proc_driver"/>

    <!-- Message Flows between Pools -->
    <messageFlow id="mf1" name="API Order Request"   sourceRef="task_api_trigger"  targetRef="task_api"/>
    <messageFlow id="mf2" name="Trip Data Response"  sourceRef="task_api"          targetRef="task_review"/>
    <messageFlow id="mf3" name="Supplier Assignment" sourceRef="task_supplier"     targetRef="task_sub_assign"/>
    <messageFlow id="mf4" name="Driver Offer"        sourceRef="task_offer"        targetRef="task_trip"/>
  </collaboration>

  <!-- ═══════════════════════════════════════════════════════════
       PROCESS 1 – TLV Transfers Office
  ═══════════════════════════════════════════════════════════ -->
  <process id="proc_office" name="TLV Transfers Office" isExecutable="false">

    <startEvent id="start1" name="Order Received"/>

    <!-- Inclusive Gateway: order source -->
    <inclusiveGateway id="igw_source" name="Order Source?"/>

    <!-- Path A: Private website - manual entry -->
    <task id="task_manual"      name="Manual Trip Entry (Website)"/>

    <!-- Path B: API - trigger call to Ride Control -->
    <task id="task_api_trigger" name="Receive via API (Auto)"/>

    <!-- Both paths merge here -->
    <task id="task_review" name="Review Incoming Trip"/>

    <!-- XOR: Supplier or Driver? -->
    <exclusiveGateway id="xgw_assign" name="Supplier or Driver?"/>

    <!-- Supplier branch -->
    <task id="task_supplier" name="Send Trip Batch to Supplier"/>
    <endEvent id="end_supplier" name="Supplier Notified"/>

    <!-- Driver branch -->
    <exclusiveGateway id="xgw_driver" name="Company Driver or Freelancer?"/>
    <task id="task_offer" name="Send WhatsApp Offer to Driver"/>
    <endEvent id="end_office" name="Trip Assigned"/>

    <!-- ── Sequence Flows ────────────────────────────────────── -->
    <sequenceFlow id="sf01" sourceRef="start1"        targetRef="igw_source"/>

    <!-- Inclusive GW branches -->
    <sequenceFlow id="sf02" name="Website (Manual)"   sourceRef="igw_source"    targetRef="task_manual"/>
    <sequenceFlow id="sf03" name="API (Automatic)"    sourceRef="igw_source"    targetRef="task_api_trigger"/>

    <!-- Manual path -->
    <sequenceFlow id="sf04" sourceRef="task_manual"      targetRef="task_review"/>

    <!-- API trigger path (response comes back via Message Flow mf2) -->
    <sequenceFlow id="sf05" sourceRef="task_api_trigger" targetRef="task_review"/>

    <!-- After review -->
    <sequenceFlow id="sf06" sourceRef="task_review"   targetRef="xgw_assign"/>

    <!-- XOR branches -->
    <sequenceFlow id="sf07" name="Supplier"           sourceRef="xgw_assign"   targetRef="task_supplier"/>
    <sequenceFlow id="sf08" name="Driver"             sourceRef="xgw_assign"   targetRef="xgw_driver"/>

    <!-- Supplier path end -->
    <sequenceFlow id="sf09" sourceRef="task_supplier" targetRef="end_supplier"/>

    <!-- Driver path -->
    <sequenceFlow id="sf10" name="Company / Freelancer" sourceRef="xgw_driver" targetRef="task_offer"/>
    <sequenceFlow id="sf11" sourceRef="task_offer"    targetRef="end_office"/>

  </process>

  <!-- ═══════════════════════════════════════════════════════════
       PROCESS 2 – Ride Control API
  ═══════════════════════════════════════════════════════════ -->
  <process id="proc_rc" name="Ride Control API" isExecutable="false">
    <task id="task_api" name="Auto-receive and Return Trip Data"/>
  </process>

  <!-- ═══════════════════════════════════════════════════════════
       PROCESS 3 – Driver / Supplier
  ═══════════════════════════════════════════════════════════ -->
  <process id="proc_driver" name="Driver / Supplier" isExecutable="false">
    <task id="task_sub_assign" name="Supplier Assigns Driver"/>
    <task id="task_trip"       name="Driver Executes Trip"/>
    <endEvent id="end_final"   name="Client Arrived at Destination"/>

    <sequenceFlow id="sf12" sourceRef="task_sub_assign" targetRef="task_trip"/>
    <sequenceFlow id="sf13" sourceRef="task_trip"       targetRef="end_final"/>
  </process>

  <!-- ═══════════════════════════════════════════════════════════
       DIAGRAM INTERCHANGE (Layout / Coordinates)
  ═══════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1" name="6.1 Diagram">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="collab1">

      <!-- ── Pools ──────────────────────────────────────────── -->
      <bpmndi:BPMNShape id="shape_part_office" bpmnElement="part_office" isHorizontal="true">
        <dc:Bounds x="30"  y="30"  width="1200" height="220"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_part_rc" bpmnElement="part_rc" isHorizontal="true">
        <dc:Bounds x="30"  y="270" width="1200" height="130"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_part_driver" bpmnElement="part_driver" isHorizontal="true">
        <dc:Bounds x="30"  y="420" width="1200" height="160"/>
      </bpmndi:BPMNShape>

      <!-- ── Pool 1 Shapes ──────────────────────────────────── -->
      <bpmndi:BPMNShape id="shape_start1" bpmnElement="start1">
        <dc:Bounds x="90"  y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_igw_source" bpmnElement="igw_source" isMarkerVisible="true">
        <dc:Bounds x="185" y="115" width="50"  height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_manual" bpmnElement="task_manual">
        <dc:Bounds x="160" y="45"  width="140" height="55"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_api_trigger" bpmnElement="task_api_trigger">
        <dc:Bounds x="160" y="190" width="140" height="55"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_review" bpmnElement="task_review">
        <dc:Bounds x="380" y="112" width="140" height="55"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_xgw_assign" bpmnElement="xgw_assign" isMarkerVisible="true">
        <dc:Bounds x="590" y="115" width="50"  height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_supplier" bpmnElement="task_supplier">
        <dc:Bounds x="570" y="45"  width="140" height="55"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end_supplier" bpmnElement="end_supplier">
        <dc:Bounds x="780" y="55"  width="36"  height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_xgw_driver" bpmnElement="xgw_driver" isMarkerVisible="true">
        <dc:Bounds x="720" y="115" width="50"  height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_offer" bpmnElement="task_offer">
        <dc:Bounds x="850" y="112" width="140" height="55"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end_office" bpmnElement="end_office">
        <dc:Bounds x="1070" y="122" width="36"  height="36"/>
      </bpmndi:BPMNShape>

      <!-- ── Pool 2 Shapes ──────────────────────────────────── -->
      <bpmndi:BPMNShape id="shape_task_api" bpmnElement="task_api">
        <dc:Bounds x="380" y="300" width="140" height="55"/>
      </bpmndi:BPMNShape>

      <!-- ── Pool 3 Shapes ──────────────────────────────────── -->
      <bpmndi:BPMNShape id="shape_task_sub_assign" bpmnElement="task_sub_assign">
        <dc:Bounds x="570" y="460" width="140" height="55"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_task_trip" bpmnElement="task_trip">
        <dc:Bounds x="850" y="460" width="140" height="55"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end_final" bpmnElement="end_final">
        <dc:Bounds x="1070" y="470" width="36"  height="36"/>
      </bpmndi:BPMNShape>

      <!-- ── Sequence Flow Edges (Pool 1) ───────────────────── -->
      <bpmndi:BPMNEdge id="edge_sf01" bpmnElement="sf01">
        <di:waypoint x="126" y="140"/>
        <di:waypoint x="185" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf02" bpmnElement="sf02">
        <di:waypoint x="210" y="115"/>
        <di:waypoint x="210" y="72"/>
        <di:waypoint x="160" y="72"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf03" bpmnElement="sf03">
        <di:waypoint x="210" y="165"/>
        <di:waypoint x="210" y="217"/>
        <di:waypoint x="160" y="217"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf04" bpmnElement="sf04">
        <di:waypoint x="300" y="72"/>
        <di:waypoint x="450" y="72"/>
        <di:waypoint x="450" y="112"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf05" bpmnElement="sf05">
        <di:waypoint x="300" y="217"/>
        <di:waypoint x="450" y="217"/>
        <di:waypoint x="450" y="167"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf06" bpmnElement="sf06">
        <di:waypoint x="520" y="140"/>
        <di:waypoint x="590" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf07" bpmnElement="sf07">
        <di:waypoint x="615" y="115"/>
        <di:waypoint x="615" y="72"/>
        <di:waypoint x="570" y="72"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf08" bpmnElement="sf08">
        <di:waypoint x="640" y="140"/>
        <di:waypoint x="720" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf09" bpmnElement="sf09">
        <di:waypoint x="710" y="72"/>
        <di:waypoint x="780" y="72"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf10" bpmnElement="sf10">
        <di:waypoint x="770" y="140"/>
        <di:waypoint x="850" y="140"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf11" bpmnElement="sf11">
        <di:waypoint x="990" y="140"/>
        <di:waypoint x="1070" y="140"/>
      </bpmndi:BPMNEdge>

      <!-- ── Sequence Flow Edges (Pool 3) ───────────────────── -->
      <bpmndi:BPMNEdge id="edge_sf12" bpmnElement="sf12">
        <di:waypoint x="710" y="487"/>
        <di:waypoint x="850" y="487"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_sf13" bpmnElement="sf13">
        <di:waypoint x="990" y="487"/>
        <di:waypoint x="1070" y="487"/>
      </bpmndi:BPMNEdge>

      <!-- ── Message Flow Edges (between Pools) ─────────────── -->
      <bpmndi:BPMNEdge id="edge_mf1" bpmnElement="mf1">
        <di:waypoint x="230" y="245"/>
        <di:waypoint x="230" y="270"/>
        <di:waypoint x="380" y="327"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_mf2" bpmnElement="mf2">
        <di:waypoint x="520" y="327"/>
        <di:waypoint x="520" y="270"/>
        <di:waypoint x="450" y="167"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_mf3" bpmnElement="mf3">
        <di:waypoint x="640" y="100"/>
        <di:waypoint x="640" y="420"/>
        <di:waypoint x="640" y="460"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="edge_mf4" bpmnElement="mf4">
        <di:waypoint x="920" y="167"/>
        <di:waypoint x="920" y="420"/>
        <di:waypoint x="920" y="460"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
