@startuml flow_a_view_open_trips
title Flow A - View Open Trips
skinparam shadowing false
skinparam defaultFontName Arial

actor Dispatcher as D
participant "DispatchBoardPanel" as Board
participant "Program\n(in-memory)" as Prog
participant Trip

note over Board
  ctor -> UiTheme.Apply, svc.Log=log,
  refreshRegionCombo(), loadTrips()
end note
Board -> Prog : iterate Program.Trips
note over Board
  keep status in {open, offered, unassigned}
  bind DataTable -> dgvTrips
end note
D -> Board : click a trip row (dgvTrips_CellClick)
Board -> Trip : seekTrip(id)
Board -> Board : selectedTrip = trip\nrefreshDrivers(); refreshOffers()
@enduml

@startuml flow_b_assign_trip_to_region
title Flow B - Assign Trip to Region (includes Maps enrichment)
skinparam shadowing false
skinparam defaultFontName Arial

actor Dispatcher as D
participant "DispatchBoardPanel" as Board
participant Trip
participant "SQL_CON" as SC
database "SQL Server" as DB
participant "DispatchService" as Svc
participant "IDriveInfoProvider" as Maps

D -> Board : select region + "Assign region"\n(btnAssignRegion_Click)
Board -> Trip : setRegion(region)
Board -> Trip : updateTrip() (quiet)
Trip -> SC : execute_non_query(sp_Trip_update)
SC -> DB : EXEC sp_Trip_update
Board -> Svc : EnrichTrip(trip)
Svc -> Maps : GetDriveInfo(pickup, dropoff, pickupTime)
note over Maps
  offline: StaticDriveInfoProvider (60 min / 0 km)
  live: GoogleMapsDriveInfoProvider (Distance Matrix)
end note
Maps --> Svc : DriveInfo(minutes, km)
Svc -> Trip : setDistanceKm / setEstimatedDurationMinutes
Svc -> Trip : updateTrip() (quiet) -> sp_Trip_update
note over Svc
  distanceKm >= 100 => trip tagged long-distance
end note
Board -> Board : refreshDrivers(); loadTrips()
@enduml

@startuml flow_c_send_trip_offer
title Flow C - Send Trip Offer (UC17)
skinparam shadowing false
skinparam defaultFontName Arial

actor Dispatcher as D
participant "DispatchBoardPanel" as Board
participant "DispatchService" as Svc
participant Region as Reg
participant "IDriverRanker" as Rank
participant Offer
participant Trip
participant "IMessageComposer" as Comp
participant "IMessageChannel" as Chan
participant Message as Msg
participant "SQL_CON" as SC

note over Board,Svc
  refreshDrivers() -> RankEligible(trip)
end note
Board -> Svc : RankEligible(trip)
Svc -> Reg : getEligibleDrivers(trip)\n(active + capacity)
Svc -> Svc : long-distance gate\n(distanceKm >= 100 -> worksLongDistance)
Svc -> Svc : exclude already-contacted\n(trip.getOffers())
Svc -> Rank : Rank(trip, eligible)
note over Rank
  offline: ProximityDriverRanker
  live: ClaudeAiService
end note
Rank --> Svc : List<RankedDriver> (rank + reason)
Svc --> Board : ranked drivers -> dgvDrivers

D -> Board : "Send offer" (btnSendOffer_Click)
Board -> Board : guard status == open;\npickDriverFromGridOrTop()
Board -> Svc : SendOffer(trip, rd)
Svc -> Offer : new Offer(pending) -> createOffer()
Offer -> SC : sp_Offer_create
Svc -> Offer : setRankReason; updateOffer() -> sp_Offer_update
Svc -> Trip : offer() open -> offered
Trip -> SC : sp_Trip_offer
Svc -> Offer : generateApprovalUrl()
Svc -> Comp : OfferMessage(driver, trip, url)
Comp --> Svc : text
Svc -> Chan : SendTemplate(phone, ContentSid, vars[7], text)
note over Chan
  offline: LoggingChannel (LOCAL-id)
  live: Twilio / Meta
end note
Chan --> Svc : waMessageId
Svc -> Msg : new Message(outbound) -> sp_Message_create
Svc --> Board : Offer
Board -> Board : loadTrips(); refreshDrivers(); refreshOffers()
@enduml

@startuml flow_d_respond_to_trip_offer
title Flow D - Respond to Trip Offer (UC07)
skinparam shadowing false
skinparam defaultFontName Arial

actor "External Driver" as Drv
participant "DispatchBoardPanel" as Board
participant "DispatchService" as Svc
participant Message as Msg
participant "IRestrictionParser" as RP
participant "IReplyInterpreter" as Intp
participant Offer
participant Trip

note over Drv,Board
  reply arrives via txtReply box (btnReceiveReply_Click)
  OR real WebhookServer.OnReply -> handleWebhookReply
end note
Drv -> Board : reply text
Board -> Svc : HandleDriverReply(offer, text)
Svc -> Msg : new Message(inbound) -> sp_Message_create
Svc -> Offer : setDriverReplyText
Svc -> RP : Parse(text)
opt availability change detected ("no nights", "on vacation")
  Svc -> Svc : ApplyRestriction -> driver setters\n+ updateExternalDriver() (sp_ExternalDriver_update)
end
Svc -> Intp : Interpret(driverName, text)
Intp --> Svc : ReplyIntent {Yes | No | Ambiguous}
Svc -> Offer : setAiInterpretation; updateOffer()
alt Yes
  Svc -> Offer : markPendingApproval()\npending -> pending_approval
else No
  Svc -> Offer : reject()\noffer -> rejected, trip -> open
else Ambiguous
  note over Svc
    no state change
    (a clarifying question would be sent)
  end note
end
Svc --> Board : intent
alt intent == No
  Board -> Svc : Forward(trip)\nsee Flow E
end

note over Drv,Board
  later: driver clicks the approval link (btnApprove_Click)
end note
Drv -> Board : approve
Board -> Offer : accept()\npending/pending_approval -> accepted,\ntrip -> confirmed
note over Board
  triggers Update Ride Control - see Flow F
end note
@enduml

@startuml flow_e_forward_offer_to_next_driver
title Flow E - Forward Offer to Next Driver
skinparam shadowing false
skinparam defaultFontName Arial

participant "DispatchBoardPanel" as Board
participant "DispatchService" as Svc
participant Trip

note over Board
  from btnDecline_Click / btnTimeout_Click /
  HandleDriverReply intent == No
end note
Board -> Svc : Forward(trip)
Svc -> Svc : RankEligible(trip)\n(re-rank, excluding already-contacted)
alt no eligible drivers remain
  Svc -> Trip : unassign()\nopen -> unassigned
  note over Svc
    escalate to manager (logged)
  end note
else next driver exists
  Svc -> Svc : SendOffer(trip, ranked[0])\nrepeats Flow C send half
end
@enduml

@startuml flow_f_update_ride_control
title Flow F - Update Ride Control (UC08)
skinparam shadowing false
skinparam defaultFontName Arial

actor "External Driver" as Drv
participant "DispatchBoardPanel" as Board
participant Offer
participant "SQL_CON" as SC
database "SQL Server" as DB
participant "RideControlSystem\n<<interface>>\n(design-only)" as RC

Drv -> Board : click approval link (btnApprove_Click)
Board -> Offer : accept()
Offer -> SC : execute_non_query(sp_Offer_accept)
SC -> DB : BEGIN TRAN:\nOffer = accepted AND Trip = confirmed\nCOMMIT
Offer -> Offer : in-memory mirror:\nstatus=accepted; trip.status=confirmed
Board -> Board : log "Ride Control updated"\n(driver name, phone, vehicle)
note over Board,RC
  updateTripAssignment() is the external contract.
  In the running app it is represented by
  the confirmed-trip side effect + narration.
end note
@enduml

@startuml appendix_startup_data_load
title Appendix - Application startup and data load
skinparam shadowing false
skinparam defaultFontName Arial

participant "Program.Main" as Main
participant "Program.initLists" as Prog
participant "SQL_CON" as SC
database "SQL Server" as DB
participant "mainForm" as Form

Main -> Main : single-instance Mutex guard
Main -> Prog : initLists()
Prog -> SC : Region.initRegions() -> sp_Region_get_all
SC -> DB : SELECT
Prog -> SC : ExternalDriver.initExternalDrivers() -> sp_ExternalDriver_get_all
Prog -> SC : ExternalDriverRegion.initExternalDriverRegions()\n(wires driver-region)
Prog -> SC : Trip.initTrips() -> sp_Trip_get_all
Prog -> SC : Offer.initOffers() -> sp_Offer_get_all
Prog -> SC : Message.initMessages() -> sp_Message_get_all
Main -> Form : Application.Run(new mainForm())
Form -> Form : showPanel(new LoginPanel())

note bottom
  Load order is strict: base entities first, FK-bearing entities next,
  Offer mediator and Message audit trail last.
end note
@enduml
