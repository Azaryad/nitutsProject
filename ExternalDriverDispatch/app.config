<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <connectionStrings>
        <!-- חיבור לשרת המקומי - לפיתוח מהבית -->
        <add name="DispatchDB"
             connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=ExternalDriverDispatch;Integrated Security=True;TrustServerCertificate=True"
             providerName="Microsoft.Data.SqlClient" />
        <!-- חיבור לשרת באוניברסיטה - יש לבטל את ההערה ולהעיר את השורה למעלה -->
        <!-- <add name="DispatchDB"
             connectionString="Data Source=IEMDBS;Initial Catalog=ExternalDriverDispatch;Integrated Security=True;TrustServerCertificate=True"
             providerName="Microsoft.Data.SqlClient" /> -->
    </connectionStrings>

    <!-- ============================================================
         External services (Maps / Claude AI / WhatsApp).
         Offline/live is decided PER SERVICE by its own *.Enabled flag
         (off = offline fallback). There is no global master switch. All
         default to false, so the app runs end-to-end with no keys and no
         internet (lab/demo safe). To demo a live call: set that service's
         *.Enabled to true and fill in its key/token. Never commit real keys.

         WhatsApp.Provider selects "meta" (Cloud API) or "twilio".
         ============================================================ -->
    <appSettings>
        <add key="Maps.Enabled" value="false" />
        <add key="Maps.ApiKey" value="" />

        <add key="Ai.Enabled" value="false" />
        <add key="Ai.ApiKey" value="" />
        <add key="Ai.Model" value="claude-sonnet-4-6" />

        <add key="WhatsApp.Enabled" value="false" />
        <add key="WhatsApp.Provider" value="meta" />
        <!-- Meta WhatsApp Cloud API -->
        <add key="WhatsApp.Token" value="" />
        <add key="WhatsApp.PhoneNumberId" value="" />
        <!-- Twilio (Account SID + Auth Token from the Twilio Console; From is your WhatsApp sender) -->
        <add key="Twilio.AccountSid" value="" />
        <add key="Twilio.AuthToken" value="" />
        <add key="Twilio.WhatsAppFrom" value="whatsapp:+15559500411" />
        <!-- Approved WhatsApp template (Content API "HX..." sid). When set, business-initiated
             offers are sent as this template with ordered variables; empty = plain Body text. -->
        <add key="Twilio.ContentSid" value="HXa08474bb07f1e6598b3f74a2a97ad2a8" />
    </appSettings>
</configuration>
